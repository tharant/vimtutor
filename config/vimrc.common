" ============================================================================
"  VIMTUTOR ADVANCED -- shared configuration for Vim 9+ and Neovim 0.10+
"
"  This file is SOURCED by ~/.vimrc and by ~/.config/nvim/init.vim (both
"  created by setup.sh), so one configuration serves both editors. It is
"  written to be safe WITHOUT any plugins: every plugin-specific block is
"  guarded, so it degrades to a plain, comfortable editor until
"  :PlugInstall has run. Edit freely -- it is your config; setup.sh never
"  rewrites it after first creation.
"
"  Layout of this file:
"    1. plugin-less defaults (options that matter)
"    2. your keys: leader + mappings
"    3. theme handling (:DotTheme)
"    4. plugins via vim-plug, guarded per editor
"    5. per-plugin configuration (coc.nvim, status line, treesitter, fzf)
" ============================================================================

" --- 0. make this file self-sufficient --------------------------------------
" The repo root (parent of config/) is put on runtimepath if missing, so
" :Tutor works even when sourced by hand.

let g:vimtutor_data = get(g:, 'vimtutor_data', expand('~/.local/share/vimtutor'))
let g:vimtutor_plugdir = get(g:, 'vimtutor_plugdir', g:vimtutor_data . '/plugged')

let s:tutor_home = fnamemodify(expand('<sfile>:p:h:h'), ':p:h')
if stridx(&runtimepath, s:tutor_home) == -1
  execute 'set runtimepath^=' . fnameescape(s:tutor_home)
endif

" --- 1. options that matter --------------------------------------------------

if !has('nvim')
  set encoding=utf-8
endif

filetype plugin indent on
syntax on

" Buffers switch without a save prompt; history survives restarts.
set hidden
try
  call mkdir(g:vimtutor_data . '/undo', 'p')
  let &undodir = g:vimtutor_data . '/undo//'
catch
endtry
if isdirectory(expand(&undodir))
  set undofile
endif

" Layout: split where your eyes are; keep context at the edges.
set splitbelow splitright
set scrolloff=8
set cursorline
set number relativenumber
set signcolumn=yes  " diagnostics reserve their gutter (coc likes this)

" Search the way you meant it: case-insensitive until CamelCase.
set incsearch hlsearch ignorecase smartcase

" Command line niceties.
set wildmenu
set wildmode=longest:full,full
set wildignore+=*.o,*.obj,*.pyc,*.so,*~,node_modules,.git,.zig-cache
set pumheight=15

" :find anywhere under the project root (Lesson 10).
set path+=**

" Real typing defaults; vim-sleuth adapts per file when installed.
set backspace=indent,eol,start
set tabstop=4 shiftwidth=4 expandtab
set smartindent
set breakindent showbreak=..
if !has('nvim')
  set nolazyredraw
endif

" Input and feedback.
set mouse=a
set timeout timeoutlen=500 ttimeoutlen=10
set updatetime=250    " snappy CursorHold (reference highlighting, §5)
if has('nvim')
  set inccommand=split
endif

" System clipboard: use it when a tool to talk to it exists. Without this
" a console vim on a headless box errors on `set clipboard=...`.
function! s:ClipboardShell() abort
  for [cmd, args] in [
        \ ['pbcopy',        ''],
        \ ['wl-copy',       ''],
        \ ['xclip',         ' -selection clipboard'],
        \ ['win32yank.exe', ' -i --crlf'],
        \ ['clip.exe',      ''],
        \ ]
    if executable(cmd)
      return 'call system(''' . cmd . args . ''', @0)'
    endif
  endfor
  return ''
endfunction

if has('clipboard') && exists('+clipboard') && !empty(s:ClipboardShell())
  set clipboard=unnamedplus
endif

" True color where the terminal promises it (dark themes look their best
" with true color); 256 colors everywhere else.
let s:tgc = (exists('$COLORTERM') && $COLORTERM =~# 'truecolor\|24bit')
      \ || (exists('$KITTY_WINDOW_ID') || exists('$WEZTERM_PANE'))
if has('nvim')
  set termguicolors
elseif exists('+termguicolors')
  if s:tgc
    set termguicolors
  else
    set t_Co=256
  endif
endif

" A decent bare status line; airline/lualine replace it when installed.
set laststatus=2
set statusline=%<\ %f\ %y\ %m%r%=%-10.(%l,%c%V%)\ %P

" --- 2. your keys ------------------------------------------------------------

let g:mapleader = ' '
let g:maplocalleader = ' '
" Leader note: dots-vim ships the default backslash leader; dots-nvim uses
" Space. The tutor serves BOTH editors from one file, so it standardizes on
" Space like dots-nvim -- one key set to teach and use in either editor.

" Files and windows
nnoremap <silent> <leader>w    :write<CR>
nnoremap <silent> <leader>x    :x<CR>
nnoremap <silent> <leader>q    :quit<CR>      " close THIS window
nnoremap <silent> <leader>v    :vsplit<CR>
nnoremap <silent> <leader>s    :split<CR>
nnoremap <silent> <leader>=    <C-W>=         " equalize splits

" Tabs and buffers
nnoremap <silent> <leader>t    :tabnew<CR>
nnoremap <silent> <leader>bl   :ls<CR>
nnoremap <silent> <leader>bb   :buffer<Space>
nnoremap <silent> <leader>e    :Explore<CR>

" Search niceties
nnoremap <silent> <leader>h    :nohlsearch<CR>

" <Leader>y sends the last-yanked text to the system clipboard. Only bound
" when a clipboard helper exists (s:ClipboardShell() above).
if !empty(s:ClipboardShell())
  execute 'nnoremap <silent> <leader>y :' . s:ClipboardShell() . '<CR>'
endif

" --- 3. theme system (:DotTheme) -----------------------------------------
"  Dots parity: `:DotTheme gruvbox` / `:DotTheme codedark` (Tab-completes),
"  same two themes, same messages, same quiet startup apply, default
"  codedark when unset. One difference: the choice is persisted to the
"  TUTOR's data dir (g:vimtutor_data/.theme = ~/.local/share/vimtutor/.theme),
"  never ~/.vim/.theme, so it cannot fight a real dots install sharing this
"  editor. Skipped entirely when :DotTheme already exists (a real dots
"  vimrc was sourced first -- it keeps ownership of the name and of startup).
if !exists(':DotTheme')

let s:theme_file = g:vimtutor_data . '/.theme'
" tokyonight is one palette with two implementations: folke/tokyonight.nvim
" (Neovim) and ghifarit53/tokyonight-vim (Vim, truecolor-only). Either way
" it loads as colorscheme `tokyonight` and its airline theme follows.
let s:themes = {
      \ 'gruvbox':    {'colorscheme': 'gruvbox',    'airline': 'gruvbox'},
      \ 'codedark':   {'colorscheme': 'codedark',   'airline': 'codedark'},
      \ 'tokyonight': {'colorscheme': 'tokyonight', 'airline': 'tokyonight'},
      \ }

function! s:LoadTheme() abort
  let name = filereadable(s:theme_file) ? trim(readfile(s:theme_file)[0]) : 'codedark'
  return has_key(s:themes, name) ? name : 'codedark'
endfunction

" Second (optional) argument: quiet -- apply without a message. Startup uses
" it so opening the editor doesn't echo anything; :DotTheme confirms.
function! s:SetTheme(name, ...) abort
  if !has_key(s:themes, a:name)
    echohl WarningMsg
    echomsg 'Unknown theme: ' . a:name
          \ . ' (available: ' . join(sort(keys(s:themes)), ', ') . ')'
    echohl None
    return
  endif
  let t = s:themes[a:name]
  if !empty(t.airline)
    let g:airline_theme = t.airline   " vim only; inert without airline
  endif
  let g:gruvbox_italic = 1
  try
    execute 'colorscheme' t.colorscheme
  catch /^Vim\%((\a\+)\)\=:E/
    if !(a:0 && a:1)                  " quiet startup stays silent
      echohl WarningMsg
      echom 'vimtutor: colorscheme ''' . t.colorscheme
            \ . ''' unavailable -- run :PlugInstall'
      echohl None
    endif
    return                            " nothing persisted on failure
  endtry
  try
    call writefile([a:name], s:theme_file)
  catch
    if !(a:0 && a:1)
      echom 'vimtutor: cannot persist theme to ' . s:theme_file
            \ . '; applied for this session only'
    endif
  endtry
  if !(a:0 && a:1)
    echom 'Theme set to ' . a:name . ' (persisted to ' . s:theme_file . ')'
  endif
endfunction

command! -nargs=1 -complete=customlist,s:ThemeComplete DotTheme call s:SetTheme(<q-args>)
function! s:ThemeComplete(arglead, cmdline, cursorpos) abort
  return filter(sort(keys(s:themes)), 'v:val =~# "^" . a:arglead')
endfunction

" Quick switching. (dots-vim binds \tg/\tc -- leader is Space here, see §2.)
nnoremap <silent> <leader>tg :DotTheme gruvbox<CR>
nnoremap <silent> <leader>tc :DotTheme codedark<CR>
nnoremap <silent> <leader>tt :DotTheme tokyonight<CR>

endif " !exists(':DotTheme')

" --- 4. plugins via vim-plug (managed in-editor) ------------------------------

" plug.vim is fetched by setup.sh into the tutor tree's autoload/.
" NB: exists('*plug#begin') does NOT resolve autoloads on Neovim, so also
" check for the file itself (a call to plug#begin() autoloads in both).
let s:plug_file = g:vimtutor_data . '/autoload/plug.vim'
let s:plug_found = exists('*plug#begin') || filereadable(s:plug_file)
if !s:plug_found
  echom 'vimtutor: vim-plug not found -- plugins are off.'
        \ ' Run setup.sh again, or see README (manual step: fetch plug.vim).'
else
  try
    call plug#begin(g:vimtutor_plugdir)

    " Completion + LSP client: one engine for both editors. Needs node >= 22.
    Plug 'neoclide/coc.nvim', {'branch': 'release'}

    " Editor-grade syntax highlighting:
    if has('nvim')
      Plug 'nvim-treesitter/nvim-treesitter', {'do': ':TSUpdate'}
    else
      Plug 'sheerun/vim-polyglot'
    endif

    " Status line:
    if has('nvim')
      Plug 'nvim-lualine/lualine.nvim'
    else
      Plug 'vim-airline/vim-airline'
      Plug 'vim-airline/vim-airline-themes'  " airline side of :DotTheme
      " No powerline glyphs: readable on every stock terminal font.
      " (dots-vim sets this flag to 1 -- an intentional diversion.)
      let g:airline_powerline_fonts = 0
    endif

    " Colorschemes -- one theme system for BOTH editors (:DotTheme).
    " tokyonight has two implementations of the same palette: folke's
    " Lua original on Neovim, ghifarit53's native Vim port (which also
    " ships the airline palette). Both load under the name `tokyonight`.
    Plug 'morhetz/gruvbox'
    Plug 'tomasiser/vim-code-dark'
    if has('nvim')
      Plug 'folke/tokyonight.nvim'
    else
      Plug 'ghifarit53/tokyonight-vim'  " truecolor-only Vim port
    endif

    " Editor quality-of-life (small, no config needed):
    Plug 'tpope/vim-fugitive'    " git: Lesson 11
    Plug 'tpope/vim-commentary'  " gcc to toggle comments
    Plug 'tpope/vim-surround'    " cs/ds/ys/S: Lesson 5
    Plug 'tpope/vim-sleuth'      " infer indentation from each file

    " Fuzzy finder -- only when its binaries are present.
    if executable('fzf')
      Plug 'junegunn/fzf'
      Plug 'junegunn/fzf.vim'
    endif

    call plug#end()
  catch
    echom 'vimtutor: vim-plug did not load cleanly: ' . v:exception
          \ . ' -- re-fetch plug.vim (re-run setup.sh).'
  endtry

  " Friendly first-run nudge, exactly once.
  autocmd VimEnter * ++once
        \ if empty(globpath(g:vimtutor_plugdir, '*'))
        \ |   echom 'vimtutor: plugins not installed yet -- run :PlugInstall'
        \ | endif

  " Startup: quietly re-apply the persisted theme. Silent skip when the
  " colorscheme isn't installed yet (plugin-less first run). The
  " !exists(':DotTheme') guard matches the theme block above: on the
  " owner's box the real dots theme system keeps startup ownership.
  if !exists(':DotTheme')
    call s:SetTheme(s:LoadTheme(), 1)
  endif
endif

" --- 5. per-plugin configuration ----------------------------------------------

" coc.nvim: completion, LSP, diagnostics (Lesson 12). Keymaps appear only
" when the plugin is actually installed, so Tab keeps working meanwhile.
if isdirectory(g:vimtutor_plugdir . '/coc.nvim')
  " Suggested extensions auto-installed at startup. coc needs node >= 22
  " at runtime (older node aborts the plugin; no node at all simply skips
  " this). Same list as the dots vimrc.
  if executable('node')
    let g:coc_global_extensions =
          \ get(g:, 'coc_global_extensions', ['coc-json', 'coc-tsserver', 'coc-pyright'])
  endif

  " Navigation (Lesson 12)
  nmap <silent> gd <Plug>(coc-definition)
  nmap <silent> gy <Plug>(coc-type-definition)
  nmap <silent> gi <Plug>(coc-implementation)
  nmap <silent> gr <Plug>(coc-references)
  nmap <silent> [g <Plug>(coc-diagnostic-prev)
  nmap <silent> ]g <Plug>(coc-diagnostic-next)
  " The nvim-LSP spelling the lessons print (same jumps):
  nmap <silent> [d <Plug>(coc-diagnostic-prev)
  nmap <silent> ]d <Plug>(coc-diagnostic-next)

  nnoremap <silent> K :call ShowDocumentation()<CR>
  function! ShowDocumentation()
    if CocAction('hasProvider', 'hover')
      call CocActionAsync('doHover')
    else
      call feedkeys('K', 'in')        " built-in keyword lookup fallback
    endif
  endfunction

  " Refactor
  nmap <silent> <leader>rn <Plug>(coc-rename)
  nmap <silent> <leader>ac <Plug>(coc-codeaction-cursor)
  nmap <silent> <leader>qf <Plug>(coc-fix-current)
  xmap <silent> <leader>f  <Plug>(coc-format-selected)

  " Highlight the symbol and its references while holding the cursor
  " (updatetime is 250, so this lands quickly -- see section 1).
  autocmd CursorHold * silent call CocActionAsync('highlight')

  " Completion popup keys -- dots semantics: Tab steps to the next item,
  " or inserts a real Tab when the cursor sits before whitespace, or asks
  " coc for completions otherwise. Shift-Tab steps back. Enter accepts the
  " selected item, or inserts a plain newline with coc's enter-format.
  inoremap <silent><expr> <TAB>
        \ coc#pum#visible() ? coc#pum#next(1) :
        \ CheckBackspace() ? "\<Tab>" :
        \ coc#refresh()
  inoremap <expr><S-TAB> coc#pum#visible() ? coc#pum#prev(1) : "\<C-h>"
  inoremap <silent><expr> <CR> coc#pum#visible() ? coc#pum#confirm()
        \                       : "\<C-g>u\<CR>\<c-r>=coc#on_enter()\<CR>"
  " Tutor-only additive extra (dots has none): Ctrl-Space still forces the
  " trigger, so Lesson 12's "if nothing pops" hint stays true.
  inoremap <silent><expr> <c-space> coc#refresh()

  function! CheckBackspace() abort
    let col = col('.') - 1
    return !col || getline('.')[col - 1] =~ '\s'
  endfunction
endif

" treesitter (Neovim): highlight a practical language set.
if has('nvim') && isdirectory(g:vimtutor_plugdir . '/nvim-treesitter')
  lua << EOTS
  local ok, ts = pcall(require, 'nvim-treesitter.configs')
  if ok then
    ts.setup({
      ensure_installed = { 'bash', 'c', 'lua', 'markdown', 'markdown_inline',
                           'python', 'query', 'vim', 'vimdoc' },
      highlight = { enable = true },
      indent = { enable = true },
    })
  end
EOTS
endif

" lualine (Neovim status line) ships with sane defaults; just make it
" feel like the vim counterpart.
if has('nvim') && isdirectory(g:vimtutor_plugdir . '/lualine.nvim')
  lua << EOLUA
  local ok, lualine = pcall(require, 'lualine')
  if ok then
    lualine.setup({
      options = {
        icons_enabled = false,          -- no Nerd Font required
        section_separators = '',
        component_separators = '|',
        theme = 'auto',                 -- follows :DotTheme (builtin
                                        -- gruvbox/codedark palettes)
      },
    })
  end
EOLUA
endif

" fzf (both editors, if the binary exists): files + content, fast.
if isdirectory(g:vimtutor_plugdir . '/fzf.vim')
  nnoremap <silent> <leader>ff :Files<CR>
  nnoremap <silent> <leader>fg :Rg<CR>
endif

" ============================================================================
"  Notes for hands-on readers (Lesson 9 is a guided tour of this file):
"  - :h options          every option explained in the built-in manual
"  - :options            browse all settings interactively
"  - :source $MYVIMRC    reload after editing
"  - :PlugInstall        install every :Plug line above
"  - :DotTheme gruvbox   switch and remember the colorscheme (Lesson 9)
"  - :CocInstall coc-pyright   add a language server for your language
" ============================================================================
